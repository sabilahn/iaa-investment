{
    "name": "codeigniter4/appstarter",
    "description": "IAA Investment - CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.5",
        "dompdf/dompdf": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}